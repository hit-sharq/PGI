// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "neon_auth"]
}

// ===== AUTHENTICATION (Better Auth - from neon_auth schema) =====
// These models reference existing Better Auth tables
model User {
  id            String    @id @db.Uuid
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // App relations
  attributionEvents AttributionEvent[]
  registrations     Registration[]
  deposits          Deposit[]

  @@schema("neon_auth")
  @@map("user")
}

// ===== ACQUISITION & ATTRIBUTION (Public Schema) =====
model AcquisitionSource {
  id        String   @id @default(cuid())
  sourceName String   @unique
  sourceType String   // "google_ads", "organic", "opera", "affiliate", "social", "direct", "other"
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns         Campaign[]
  attributionEvents AttributionEvent[]
  registrations     Registration[]

  @@schema("public")
  @@map("acquisition_source")
}

model Campaign {
  id                  String   @id @default(cuid())
  externalCampaignId  String?
  name                String
  sourceId            String
  source              AcquisitionSource @relation(fields: [sourceId], references: [id])
  status              String   @default("active") // "active", "paused", "ended"
  
  // Performance metrics
  dailyBudget         Float?
  totalSpend          Float    @default(0)
  impressions         Int      @default(0)
  clicks              Int      @default(0)
  registrations       Int      @default(0)
  verifiedUsers       Int      @default(0)
  ftdCount            Int      @default(0)
  totalDepositValue   Float    @default(0)
  
  // Google Ads specific
  googleAdsConversions Int    @default(0)
  googleAdsConversionValue Float @default(0)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  attributionEvents   AttributionEvent[]
  adGroups            AdGroup[]

  @@index([sourceId])
  @@schema("public")
  @@map("campaign")
}

model AdGroup {
  id                 String   @id @default(cuid())
  externalAdGroupId  String?
  name               String
  campaignId         String
  campaign           Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  clicks             Int      @default(0)
  impressions        Int      @default(0)
  conversions        Int      @default(0)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  keywords           Keyword[]
  attributionEvents  AttributionEvent[]

  @@index([campaignId])
  @@schema("public")
  @@map("ad_group")
}

model Keyword {
  id                String   @id @default(cuid())
  externalKeywordId String?
  keyword           String
  adGroupId         String
  adGroup           AdGroup  @relation(fields: [adGroupId], references: [id], onDelete: Cascade)
  
  clicks            Int      @default(0)
  impressions       Int      @default(0)
  conversions       Int      @default(0)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  attributionEvents AttributionEvent[]

  @@index([adGroupId])
  @@schema("public")
  @@map("keyword")
}

// ===== ATTRIBUTION EVENTS =====
model AttributionEvent {
  id                String   @id @default(cuid())
  userId            String   @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Tracking parameters
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  utmContent        String?
  utmTerm           String?
  gclid             String?   // Google Click ID
  
  // Campaign attribution
  sourceId          String?
  source            AcquisitionSource? @relation(fields: [sourceId], references: [id])
  campaignId        String?
  campaign          Campaign? @relation(fields: [campaignId], references: [id])
  adGroupId         String?
  adGroup           AdGroup?  @relation(fields: [adGroupId], references: [id])
  keywordId         String?
  keyword           Keyword?  @relation(fields: [keywordId], references: [id])
  
  // Landing page & context
  landingPage       String?
  referrer          String?
  
  clickedAt         DateTime  @default(now())
  sessionId         String?   @default(cuid())
  
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([campaignId])
  @@index([sourceId])
  @@schema("public")
  @@map("attribution_event")
}

// ===== USER CONVERSION FUNNEL =====
model Registration {
  id                String   @id @default(cuid())
  userId            String   @unique @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  sourceId          String?
  source            AcquisitionSource? @relation(fields: [sourceId], references: [id])
  campaignId        String?
  
  email             String?
  ipAddress         String?
  userAgent         String?
  
  registeredAt      DateTime  @default(now())
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())

  @@index([sourceId])
  @@schema("public")
  @@map("registration")
}

model Deposit {
  id                String   @id @default(cuid())
  userId            String   @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  amount            Float
  currency          String   @default("KES")
  status            String   @default("pending") // "pending", "completed", "failed", "reversed"
  
  isFirstDeposit    Boolean  @default(false)
  
  externalDepositId String?
  paymentMethod     String?
  
  depositedAt       DateTime
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
  @@index([isFirstDeposit])
  @@schema("public")
  @@map("deposit")
}

// ===== SEO & LANDING PAGES =====
model LandingPage {
  id                String   @id @default(cuid())
  url               String   @unique
  title             String?
  description       String?
  
  sessions          Int      @default(0)
  clicks            Int      @default(0)
  registrations     Int      @default(0)
  ftdCount          Int      @default(0)
  totalDepositValue Float    @default(0)
  
  lastTrafficAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@schema("public")
  @@map("landing_page")
}

model SEOMetric {
  id                String   @id @default(cuid())
  query             String
  pageUrl           String
  
  impressions       Int      @default(0)
  clicks            Int      @default(0)
  ctr               Float    @default(0)
  position          Float    @default(0)
  
  registrations     Int      @default(0)
  ftdCount          Int      @default(0)
  
  dataSource        String   @default("gsc") // "gsc" = Google Search Console
  lastSync          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([query, pageUrl])
  @@schema("public")
  @@map("seo_metric")
}

// ===== ALERTS & NOTIFICATIONS =====
model Alert {
  id                String   @id @default(cuid())
  title             String
  description       String
  severity          String   // "critical", "warning", "info"
  type              String   // "ftd_drop", "cost_increase", "conversion_anomaly", "tracking_issue", etc.
  
  isResolved        Boolean  @default(false)
  resolvedAt        DateTime?
  
  metadata          Json?
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@schema("public")
  @@map("alert")
}

// ===== INTEGRATIONS & TRACKING =====
model IntegrationCredential {
  id                String   @id @default(cuid())
  provider          String   // "google_ads", "gsc", "ga4", "opera", etc.
  accountId         String
  
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  
  isActive          Boolean  @default(true)
  lastSync          DateTime?
  
  metadata          Json?
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([provider, accountId])
  @@schema("public")
  @@map("integration_credential")
}

model ConversionAction {
  id                String   @id @default(cuid())
  externalId        String?
  name              String
  category          String   // "purchase", "signup", "registration", "form_submission", "page_view", "other"
  
  isPrimary         Boolean  @default(false)
  trackingMethod    String   // "pixel", "conversion_api", "manual", "other"
  
  conversionCount   Int      @default(0)
  totalValue        Float    @default(0)
  
  lastRecordedAt    DateTime?
  dataSource        String   // "google_ads", "internal", "pixel", "api"
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@schema("public")
  @@map("conversion_action")
}
