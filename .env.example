# Database Connection
# Create a PostgreSQL database on Neon and paste the connection string here
DATABASE_URL="postgresql://user:password@host.neon.tech/database?sslmode=require"

# Better Auth Secret - Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-secret-key-here-min-32-chars"

# Optional: Better Auth custom domain (auto-detected if not set)
# BETTER_AUTH_URL="https://yourdomain.com"

# API Keys for integrations (configure in dashboard)
# GOOGLE_ADS_API_KEY="..."
# GA4_API_KEY="..."
# GSC_API_KEY="..."

# Node environment
NODE_ENV="development"
